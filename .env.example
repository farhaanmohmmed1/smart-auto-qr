# 🔐 ENVIRONMENT TEMPLATE
# 
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in YOUR values below
# 3. NEVER commit .env file to Git!
# 4. For Vercel: Set these in Project Settings > Environment Variables

# ==========================================
# 🌍 ENVIRONMENT MODE
# ==========================================
# Values: 'development' | 'production'
ENVIRONMENT=development

# ==========================================
# 🗄️  DATABASE CONFIGURATION
# ==========================================
# For PlanetScale, Railway, or Aiven MySQL

# PlanetScale example:
#   Host: aws.connect.psdb.cloud
#   User: xxxxxxxxxxxxx
#   Password: pscale_pw_xxxxxxxxxxxxxxxxxxxxxxx

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_auto_db
DB_USER=root
DB_PASS=your_db_password_here

# ==========================================
# 🔑 JWT AUTHENTICATION SECRET
# ==========================================
# Generate with: openssl rand -base64 32
# MUST be 32+ characters and unique!
# ⚠️  Change this immediately!

JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long_change_me

# ==========================================
# 🌐 APPLICATION URLs
# ==========================================
# Development:
#   API_URL=http://localhost:3000/api
#   FRONTEND_URL=http://localhost:3000
# 
# Production (Vercel):
#   API_URL=https://yourapp.vercel.app/api
#   FRONTEND_URL=https://yourapp.vercel.app

API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000

# ==========================================
# 📁 FILE STORAGE STRATEGY
# ==========================================
# Options: 'local' | 'cloudinary' | 's3'
# 
# local:      Generate QR on-the-fly (recommended, free)
# cloudinary: Cloud CDN with transformations
# s3:         AWS S3 or S3-compatible storage

FILE_STORAGE=local

# ==========================================
# ☁️  CLOUDINARY (Optional)
# ==========================================
# Only needed if FILE_STORAGE=cloudinary
# Get credentials from: https://cloudinary.com/console
# 
# Free tier: 25 GB storage, unlimited bandwidth

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ==========================================
# 🚀 OPTIONAL: AWS S3 (Not recommended for free tier)
# ==========================================
# Only needed if FILE_STORAGE=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ==========================================
# 📊 OPTIONAL: ERROR TRACKING (Sentry)
# ==========================================
# Free tier: 5K errors/month
# Get from: https://sentry.io

SENTRY_DSN=

# ==========================================
# 📧 OPTIONAL: EMAIL SERVICE (for notifications)
# ==========================================
# For SOS alerts via email

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@smartautoqr.com

# ==========================================
# 🚨 EMERGENCY CONTACTS
# ==========================================
# Police helpline number
HELPLINE=100

# WhatsApp number for SOS (with country code: 91 for India)
SOS_WHATSAPP=919876543210

# ==========================================
# ⚙️  ADVANCED OPTIONS
# ==========================================

# Database connection timeout (seconds)
DB_TIMEOUT=5

# JWT token expiry (seconds, default 24 hours)
JWT_EXPIRY=86400

# Session timeout (seconds, default 24 hours)
SESSION_TIMEOUT=86400

# Rate limiting: max requests per minute per IP
API_RATE_LIMIT=30

# Queue driver (optional, for background jobs)
QUEUE_DRIVER=sync

# Cache driver (optional, for performance)
CACHE_DRIVER=array

# ==========================================
# 🔒 SECURITY SETTINGS
# ==========================================
# Should cookie require HTTPS?
# true = Only over HTTPS (production)
# false = HTTP allowed (development)

SECURE_COOKIE=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 📝 NOTES
# ==========================================
# 
# DEVELOPMENT (.env file)
#   - Keep .env in .gitignore
#   - Load from this file locally
#   - Use weaker credentials for testing
# 
# PRODUCTION (Vercel)
#   - Set variables in Vercel dashboard
#   - No .env file needed
#   - Use strong, unique credentials
#   - Store secrets securely
# 
# TO GENERATE JWT_SECRET:
#   Mac/Linux:  openssl rand -base64 32
#   Windows:    certutil -encodehex -f "C:\input.txt" test.txt | find /V "Input Length"
#   Or use online generator: https://generate-uuid.com
