# Smart Auto QR Safety System — Apache Security Config
# Place in root of project

Options -Indexes
ServerSignature Off

# ── HTTPS / SSL Enforcement ────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS for all traffic (except local development)
    # Comment out these 2 lines if in development (localhost)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # ── Hide Admin Directory ──────────────────────────────────
    # Redirect /admin or /admin/ to /admin/login.php (hides structure)
    # Direct file access still works, but directory listing is prevented
    RewriteCond %{REQUEST_URI} ^/admin/?$ [OR]
    RewriteCond %{REQUEST_URI} ^/admin/$ 
    RewriteRule ^admin/?$ admin/login.php [L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    # Enable HSTS (force HTTPS for 1 year, including subdomains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    
    # Prevent clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection in older browsers
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self';"
    
    # Remove server version
    Header always unset X-Powered-By
</IfModule>

# ── Protect sensitive directories ─────────────────────────────
<FilesMatch "\.(sql|md|env|log|sh|bak|zip)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Protect config directory ───────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
    RewriteRule ^lib/    - [F,L]
    RewriteRule ^uploads/ - [F,L]
</IfModule>

# ── Enable compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ── Cache static assets ────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType text/css   "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>
